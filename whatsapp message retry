<!-- Pata hai WhatsApp aapke background me ek cheez continously CHECK karta rehta hai... aur aapko khabar bhi nahi hoti!" -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Message Retry — JavaScript while Loop Visualizer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600;700&family=Inter:wght@400;600;700;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0d0d0d;
            color: #f3f4f6;
        }

        .code-font {
            font-family: 'Fira Code', monospace;
        }

        /* Highlight animation for video recording reels */
        .code-line {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
            padding: 10px 14px;
            border-radius: 0 8px 8px 0;
        }

        .code-line.active {
            background-color: rgba(37, 211, 102, 0.2);
            border-left-color: #25D366;
            color: #ffffff;
            font-weight: 700;
            transform: translateX(4px);
        }

        /* Pulse spinner animation */
        @keyframes pulse-retry {
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.1); opacity: 1; }
        }
        .pulse-anim {
            animation: pulse-retry 1.2s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-center items-center p-4 lg:p-8">

    <header class="w-full max-w-4xl mb-6 flex justify-between items-center border-b border-gray-800 pb-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#25D366]/20 border border-[#25D366]/40 flex items-center justify-center font-bold text-[#25D366] shadow-lg shadow-[#25D366]/20">
                <i class="fa-brands fa-whatsapp text-xl"></i>
            </div>
            <div>
                <h1 class="text-xl font-black text-white tracking-tight">WhatsApp <span class="text-[#25D366]">Message Retry</span></h1>
                <p class="text-xs text-gray-400">JavaScript while Loop Concept</p>
            </div>
        </div>

        <button onclick="resetDemo()" class="px-4 py-2 bg-gray-900 hover:bg-gray-800 border border-gray-700 text-gray-200 text-xs font-bold rounded-xl transition-all flex items-center gap-2">
            <i class="fa-solid fa-rotate-right text-[#25D366]"></i> Reset Demo
        </button>
    </header>

    <main class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">

        <!-- ================= LEFT COLUMN: WHATSAPP UI ================= -->
        <section class="bg-[#141414] border border-gray-800 rounded-2xl p-6 flex flex-col justify-between shadow-2xl relative overflow-hidden">
            <div>
                <div class="flex justify-between items-center mb-6 border-b border-gray-800 pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-emerald-700/50 flex items-center justify-center text-white text-xs font-bold border border-emerald-500">
                            AH
                        </div>
                        <div>
                            <div class="text-xs font-bold text-gray-200">Ali Hassan</div>
                            <div id="connectionStatus" class="text-[10px] text-amber-400 font-semibold flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Waiting for network...
                            </div>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono px-2.5 py-1 bg-gray-900 text-gray-400 border border-gray-800 rounded-full">
                        WhatsApp Web
                    </span>
                </div>

                <!-- Chat Message Display Box -->
                <div class="bg-[#0b141a] p-4 rounded-xl border border-gray-800 min-h-[160px] flex flex-col justify-end space-y-3">
                    <!-- Sent message bubble -->
                    <div class="self-end max-w-[85%] bg-[#005c4b] text-white p-3 rounded-2xl rounded-tr-none text-xs shadow-md">
                        <p class="leading-relaxed">Bhai internet wapis aa gaya? Send me the code!</p>
                        <div class="flex items-center justify-end gap-1.5 mt-1 text-[10px] text-emerald-200/70">
                            <span>10:42 PM</span>
                            <span id="tickIcon" class="text-amber-300 font-bold">
                                <i class="fa-regular fa-clock"></i>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Trigger Action Button -->
                <button id="startBtn" onclick="runLoop()" class="w-full mt-5 py-4 bg-[#25D366] hover:bg-[#20bd5a] text-black font-extrabold text-sm rounded-xl shadow-lg shadow-[#25D366]/20 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-[#0b141a] fa-wifi"></i> Reconnect Internet & Retry
                </button>
            </div>

            <!-- Live Status Screen -->
            <div class="mt-6 pt-4 border-t border-gray-800">
                <div class="text-xs text-gray-400 font-bold uppercase mb-2">Network Action</div>
                <div id="statusCard" class="w-full p-4 rounded-xl bg-gray-900 border border-gray-800 flex items-center gap-3">
                    <div id="statusIcon" class="w-10 h-10 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg shrink-0">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div>
                        <div id="statusTitle" class="text-xs font-bold text-gray-200">Message Pending...</div>
                        <div id="statusDesc" class="text-[11px] text-gray-500">Loop waiting for internet connection</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= RIGHT COLUMN: CODE EXECUTION ================= -->
        <section class="bg-[#141414] border border-gray-800 rounded-2xl p-6 flex flex-col justify-between shadow-2xl">
            <div>
                <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-800">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-code text-[#25D366]"></i> Code Execution
                    </span>
                    <span class="text-[10px] code-font text-gray-500 uppercase">Live Line Highlight</span>
                </div>

                <!-- Code Container -->
                <div id="code-box" class="code-font text-xs sm:text-sm text-gray-300 space-y-1.5 my-2">
                    <!-- Dynamic code injected here -->
                </div>
            </div>

            <!-- Variable Memory Inspector -->
            <div class="mt-6 pt-4 border-t border-gray-800">
                <div class="text-[10px] code-font text-gray-500 uppercase mb-2">Memory Variable</div>
                <div class="bg-[#0a0a0a] p-3 rounded-xl border border-gray-800 flex justify-between items-center code-font text-xs">
                    <span class="text-purple-400 font-bold">isDelivered</span>
                    <span id="var-delivered-display" class="text-red-400 font-bold px-3 py-1 bg-red-950/40 border border-red-800/50 rounded-lg">
                        false
                    </span>
                </div>
            </div>
        </section>

    </main>

    <script>
        // State variables
        let isDelivered = false;
        let isRunning = false;

        // Web Audio API Sound Generator for reels
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSfx(freq, type = 'sine', duration = 0.15) {
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.value = freq;
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch(e) {}
        }

        // Delay helper for reel visual steps
        const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

        // Code snippet
        const codeLines = [
            { id: 1, text: `<span class="text-purple-400">let</span> isDelivered = <span class="text-red-400 font-bold">false</span>;` },
            { id: 2, text: `` },
            { id: 3, text: `<span class="text-purple-400">while</span> (!isDelivered) {` },
            { id: 4, text: `  <span class="text-blue-400">console</span>.<span class="text-yellow-400">log</span>(<span class="text-emerald-300">"Retrying..."</span>);` },
            { id: 5, text: `  isDelivered = <span class="text-emerald-400 font-bold">true</span>;` },
            { id: 6, text: `}` },
            { id: 7, text: `` },
            { id: 8, text: `<span class="text-blue-400">console</span>.<span class="text-yellow-400">log</span>(<span class="text-emerald-300">"Message Sent! 🎉"</span>);` }
        ];

        function renderCode() {
            const container = document.getElementById('code-box');
            container.innerHTML = codeLines.map(l => `
                <div id="line-${l.id}" class="code-line flex items-center gap-3">
                    <span class="text-gray-600 text-[10px] w-4 text-right select-none">${l.id}</span>
                    <span class="flex-1">${l.text}</span>
                </div>
            `).join('');
        }

        function highlight(lineNum) {
            document.querySelectorAll('.code-line').forEach(el => el.classList.remove('active'));
            if (lineNum) {
                const target = document.getElementById(`line-${lineNum}`);
                if (target) target.classList.add('active');
            }
        }

        function updateUI() {
            const display = document.getElementById('var-delivered-display');
            const icon = document.getElementById('statusIcon');
            const title = document.getElementById('statusTitle');
            const desc = document.getElementById('statusDesc');
            const tickIcon = document.getElementById('tickIcon');
            const connStatus = document.getElementById('connectionStatus');

            display.innerText = `${isDelivered}`;

            if (!isDelivered) {
                display.className = "text-red-400 font-bold px-3 py-1 bg-red-950/40 border border-red-800/50 rounded-lg";
                icon.className = "w-10 h-10 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg pulse-anim";
                icon.innerHTML = `<i class="fa-regular fa-clock"></i>`;
                title.innerText = "Retrying Delivery...";
                title.className = "text-xs font-bold text-amber-400";
                desc.innerText = "Loop condition (!isDelivered) is TRUE";
                tickIcon.innerHTML = `<i class="fa-regular fa-clock"></i>`;
                tickIcon.className = "text-amber-300 font-bold";
                connStatus.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Connecting...`;
                connStatus.className = "text-[10px] text-amber-400 font-semibold flex items-center gap-1.5";
            } else {
                display.className = "text-[#25D366] font-bold px-3 py-1 bg-emerald-950/40 border border-emerald-800/50 rounded-lg";
                icon.className = "w-10 h-10 rounded-full bg-[#25D366]/20 text-[#25D366] border border-[#25D366]/40 flex items-center justify-center text-lg shadow-lg shadow-[#25D366]/20";
                icon.innerHTML = `<i class="fa-solid fa-check-double"></i>`;
                title.innerText = "Message Delivered! 🎉";
                title.className = "text-xs font-bold text-[#25D366]";
                desc.innerText = "Loop ended because isDelivered is now TRUE";
                tickIcon.innerHTML = `<i class="fa-solid fa-check-double"></i>`;
                tickIcon.className = "text-sky-400 font-bold";
                connStatus.innerHTML = `<span class="w-2 h-2 rounded-full bg-[#25D366]"></span> Online`;
                connStatus.className = "text-[10px] text-[#25D366] font-semibold flex items-center gap-1.5";
            }
        }

        async function runLoop() {
            if (isRunning) return;
            isRunning = true;
            document.getElementById('startBtn').disabled = true;
            document.getElementById('startBtn').classList.add('opacity-50', 'cursor-not-allowed');

            // Reset initial state
            isDelivered = false;
            updateUI();

            // Line 1: Declare isDelivered = false
            highlight(1);
            playSfx(350);
            await sleep(800);

            // Line 3: Evaluate while (!isDelivered) -> TRUE
            highlight(3);
            playSfx(440);
            await sleep(900);

            // Line 4: Console log "Retrying..."
            highlight(4);
            playSfx(520);
            await sleep(900);

            // Line 5: Update isDelivered = true
            highlight(5);
            isDelivered = true;
            updateUI();
            playSfx(660);
            await sleep(1000);

            // Line 3: Check condition again -> NOW FALSE (!true = false)
            highlight(3);
            playSfx(300, 'sawtooth');
            await sleep(900);

            // Line 8: Exit loop and log final message
            highlight(8);
            playSfx(880, 'sine', 0.3);
            await sleep(400);

            isRunning = false;
            document.getElementById('startBtn').disabled = false;
            document.getElementById('startBtn').classList.remove('opacity-50', 'cursor-not-allowed');
        }

        function resetDemo() {
            isDelivered = false;
            isRunning = false;
            document.getElementById('startBtn').disabled = false;
            document.getElementById('startBtn').classList.remove('opacity-50', 'cursor-not-allowed');
            highlight(1);
            updateUI();
            
            // Reset to initial pending screen
            document.getElementById('statusTitle').innerText = "Message Pending...";
            document.getElementById('statusTitle').className = "text-xs font-bold text-gray-200";
            document.getElementById('statusDesc').innerText = "Click button to trigger loop execution";
            document.getElementById('statusIcon').className = "w-10 h-10 rounded-full bg-gray-800 text-gray-400 border border-gray-700 flex items-center justify-center text-lg";
            document.getElementById('statusIcon').innerHTML = `<i class="fa-solid fa-wifi"></i>`;
            document.getElementById('connectionStatus').innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Offline`;
            document.getElementById('connectionStatus').className = "text-[10px] text-amber-400 font-semibold flex items-center gap-1.5";
        }

        window.onload = () => {
            renderCode();
            resetDemo();
        };
    </script>
</body>
</html>
